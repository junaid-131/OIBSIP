<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:padding="12dp">

    <!-- Display Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/displayCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#181A1F"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/buttonPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Expression -->
            <TextView
                android:id="@+id/expressionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="2"
                android:text=""
                android:textColor="#8E939E"
                android:textSize="20sp"
                android:fontFamily="sans"
                android:paddingBottom="8dp" />

            <!-- Result -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:fontFamily="sans" />

                <ImageButton
                    android:id="@+id/buttonCopy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy result"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Calculator Buttons -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.67"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1 -->

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="C"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B3261E"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonBackspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="⌫"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/buttonClear"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonPercent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="%"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/buttonBackspace"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonDivide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="÷"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- Row 2 -->

        <Button
            android:id="@+id/button7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="7"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonClear" />

        <Button
            android:id="@+id/button8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="8"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button7"
            app:layout_constraintTop_toBottomOf="@id/buttonClear" />

        <Button
            android:id="@+id/button9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="9"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button8"
            app:layout_constraintTop_toBottomOf="@id/buttonClear" />

        <Button
            android:id="@+id/buttonMultiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="×"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonClear" />


        <!-- Row 3 -->

        <Button
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="4"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button7" />

        <Button
            android:id="@+id/button5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="5"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button4"
            app:layout_constraintTop_toBottomOf="@id/button7" />

        <Button
            android:id="@+id/button6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="6"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button5"
            app:layout_constraintTop_toBottomOf="@id/button7" />

        <Button
            android:id="@+id/buttonSubtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="−"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button7" />


        <!-- Row 4 -->

        <Button
            android:id="@+id/button1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="1"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button4" />

        <Button
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="2"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button1"
            app:layout_constraintTop_toBottomOf="@id/button4" />

        <Button
            android:id="@+id/button3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="3"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button2"
            app:layout_constraintTop_toBottomOf="@id/button4" />

        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="+"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button4" />


        <!-- Row 5 -->

        <Button
            android:id="@+id/buttonSign"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="±"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button1" />

        <Button
            android:id="@+id/button0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="0"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/buttonSign"
            app:layout_constraintTop_toBottomOf="@id/button1" />

        <Button
            android:id="@+id/buttonDecimal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="."
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22252B"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/button0"
            app:layout_constraintTop_toBottomOf="@id/button1" />

        <Button
            android:id="@+id/buttonEquals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="="
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button1" />


        <!-- Scientific Row -->

        <Button
            android:id="@+id/buttonOpenParenthesis"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="("
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonSign" />

        <Button
            android:id="@+id/buttonCloseParenthesis"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text=")"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/buttonOpenParenthesis"
            app:layout_constraintTop_toBottomOf="@id/buttonSign" />

        <Button
            android:id="@+id/buttonSqrt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="√"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/buttonCloseParenthesis"
            app:layout_constraintTop_toBottomOf="@id/buttonSign" />

        <Button
            android:id="@+id/buttonSquare"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="x²"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonSign" />


        <!-- Bottom Utility Row -->

        <Button
            android:id="@+id/buttonReciprocal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="1/x"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonOpenParenthesis" />

        <Button
            android:id="@+id/buttonHistory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="History"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#292C33"
            app:layout_constraintWidth_percent="0.72"
            app:layout_constraintHeight_percent="0.12"
            app:layout_constraintStart_toEndOf="@id/buttonReciprocal"
            app:layout_constraintTop_toBottomOf="@id/buttonOpenParenthesis" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>